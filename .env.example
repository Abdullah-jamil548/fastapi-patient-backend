# ==========================================
# SPEECH THERAPY BACKEND - ENVIRONMENT CONFIG
# ==========================================

# Server Environment (production / development)
ENVIRONMENT=production
PORT=8000

# Supabase PostgreSQL Cloud Database Configuration (Service Role bypasses RLS for backend queries)
SUPABASE_URL=https://fwrkrpmqmqxlgvyzrizq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Local fallback SQLite (only used if Supabase credentials are not provided)
DATABASE_URL=sqlite+aiosqlite:///./speecheasy.db

# Groq API for AI Chatbot Assistant
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# SpeechEasy JWT Authentication (MUST match patient_auth_service JWT_SECRET_KEY)
JWT_SECRET_KEY=speecheasy_patient_super_secret_production_key_498273948729384792384
JWT_ALGORITHM=HS256

# CORS Allowed Origins (JSON array or comma-separated string)
CORS_ORIGINS=["*"]

# Chatbot Rate Limiting & Timeout
CHAT_RATE_LIMIT=20
CHAT_REQUEST_TIMEOUT=30
